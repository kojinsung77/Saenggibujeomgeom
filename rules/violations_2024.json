{
  "year": 2024,
  "source": "교육부 학교생활기록부 기재요령 2024",
  "updated": "2024-03-01",
  "patterns": [
    {
      "id": "corp",
      "type": "기관명·기업명 직접 기재",
      "regex": "삼성전자|LG전자|SK하이닉스|현대자동차|기아자동차|롯데|카카오|네이버|구글|애플|마이크로소프트|아마존|메타|인텔|엔비디아|현대중공업|포스코|KB국민은행|신한은행|우리은행|하나은행|NH농협",
      "severity": "high",
      "note": "특정 기업명 직접 기재 금지 (봉사활동 기관명 필드 포함)",
      "boundary_check": true
    },
    {
      "id": "hospital",
      "type": "병원·의원명 직접 기재",
      "regex": "[가-힣]{2,8}(?:대학교?|대|의대)?\\s*(?:병원|의원|한의원)",
      "severity": "high",
      "note": "구체적 병원·의원명 직접 기재 금지 (치과·약국·클리닉은 직업명으로 혼동 가능해 제외)",
      "exclude_regex": "(?:의사|의학|의대|한의사|한의학|치의학|약학|진로|꿈|장래희망|직업|체험|실습|봉사)"
    },
    {
      "id": "univ",
      "type": "특정 대학명 직접 기재",
      "regex": "서울대학교|연세대학교|고려대학교|카이스트|KAIST|포항공과대학교|포스텍|POSTECH|성균관대학교|한양대학교|이화여자대학교|중앙대학교|경희대학교|한국외국어대학교|서강대학교|숙명여자대학교|서울대|연세대|고려대|한양대|성균관대|이화여대",
      "severity": "high",
      "note": "특정 대학명·입시 관련 대학명 직접 기재 금지",
      "boundary_check": true
    },
    {
      "id": "score",
      "type": "구체적 점수·등수 직접 기재",
      "regex": "\\d{2,3}점(?!\\s*(?:만점|척도|기준|형식|항목|배점))|\\d+등(?:\\s|$|[,.])|상위\\s*\\d+%|하위\\s*\\d+%|전국\\s*\\d+위|전교\\s*\\d+위",
      "severity": "medium",
      "note": "구체적 점수·등수·석차 직접 기재 금지 (석차등급·만점·척도 기준은 허용)"
    },
    {
      "id": "gender",
      "type": "성별 직접 기재",
      "regex": "남학생|여학생|남자\\s*학생|여자\\s*학생",
      "severity": "high",
      "note": "성별 직접 기재 금지"
    },
    {
      "id": "realname",
      "type": "타인 실명 직접 기재",
      "regex": "(?:담임|지도)?\\s*(?:선생님|교사|교수|강사)\\s*[가-힣]{2,3}|[가-힣]{2,3}\\s*(?:선생님|교사|교수)",
      "severity": "medium",
      "note": "학생 본인 외 타인 실명 기재 금지 (직책+이름 패턴)",
      "exclude_regex": "^(?:과학|수학|영어|국어|체육|음악|미술|사회|역사|지리|가정|정보|기술|경제|윤리|철학|법과|세계|한국|담임|지도|봉사|활동|수업|상담|보건|영양|사서|전문)\\s*(?:선생님|교사|교수|강사)"
    },
    {
      "id": "award",
      "type": "교내 수상명·수상실적 기재",
      "regex": "(?:교내|학교|전교)\\s*(?:[가-힣]+\\s*)?(?:대상|최우수상|우수상|장려상|금상|은상|동상|특별상|표창장)\\s*수상",
      "severity": "high",
      "note": "세특·행특에 수상경력 직접 연계 기재 금지"
    },
    {
      "id": "abbrev",
      "type": "의미 불명확한 약어 사용",
      "regex": "(?<![A-Za-z가-힣])[A-Z]{3,}(?![A-Za-z가-힣])",
      "severity": "low",
      "note": "널리 알려지지 않은 약어는 괄호 안에 풀어서 기재",
      "exclude_regex": "^(?:DNA|RNA|ATP|ADP|ICT|GPS|LED|LCD|CPU|GPU|API|URL|USB|PDF|PPT|UCC|ESG|SDG|SOS|IMF|WHO|UNESCO|UNICEF|NASA|VR|AR|MR|IoT|SNS|NGO|NPO|PBL|STEAM|STEM|CT|SW|GNP|GDP|GNI|ODA|ISO|KPI|CSR|TED|UN|EU|WTO|KTX|IQ|EQ|IT|PC|TV|UV|IR|NMR|PCR|CRT|MRI|CT)$"
    }
  ]
}